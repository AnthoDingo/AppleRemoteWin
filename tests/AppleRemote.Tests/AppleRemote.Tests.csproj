<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AppleRemote.Core\AppleRemote.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vraie capture d'une A1962 (open-appleremote, MIT) : octets de reports, temps relatifs, libellés d'étapes. -->
    <None Update="sample.jsonl" CopyToOutputDirectory="PreserveNewest" />
    <!-- Sortie du code Python de référence (decode.py + gestures.py) sur cette même capture. -->
    <None Update="golden.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
