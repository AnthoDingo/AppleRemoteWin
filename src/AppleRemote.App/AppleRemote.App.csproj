<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>AppleRemote.App</RootNamespace>
    <AssemblyName>AppleRemote</AssemblyName>
    <Version>1.2.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Published with a RID: self-contained, so the app runs without .NET installed. App, macro editor and filter
         installer are published to the same folder and share that runtime; they must agree (NETSDK1150/1151). -->
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <!-- Debug page and its menu entry: off by default, enabled only by a Debug build. -->
    <EnableDebugPage>false</EnableDebugPage>
    <EnableDebugPage Condition="'$(Configuration)' == 'Debug'">true</EnableDebugPage>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableDebugPage)' == 'true'">
    <DefineConstants>$(DefineConstants);DEBUG_PAGE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AppleRemote.DriverInstaller\AppleRemote.DriverInstaller.csproj" />
    <ProjectReference Include="..\AppleRemote.Windows\AppleRemote.Windows.csproj" />
    <!-- The filter installer (elevation) is copied next to the exe; the application references none of its types. -->
    <ProjectReference Include="..\AppleRemote.DriverInstaller\AppleRemote.DriverInstaller.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="WPF-UI.Tray" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Éditeur de macro : Blockly 11.2.2 (Apache-2.0) et sa page, servis au WebView2 depuis le dossier de l'exe. -->
    <Content Include="Blockly\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Realtek RTL8761B patch (TP-Link UB500) from linux-firmware rtl_bt/, sent by RealtekFirmware under WinUSB;
         redistributable unmodified with its licence. -->
    <Content Include="firmware\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\" />
  </ItemGroup>

  <!-- Release: downloads the latest published AppleRemoteDriver package (github.com/AnthoDingo/AppleRemoteWin-Driver:
       .sys, .inf, .cat, test certificate) and copies it next to the exe. Offline or AppleRemoteDriver=false: skipped. -->
  <!-- Evaluated late: IntermediateOutputPath is empty at project evaluation (the package would land in the project folder). -->
  <Target Name="DriverPackagePath" BeforeTargets="BuildDriver;PublishDriver">
    <PropertyGroup>
      <DriverPackage>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)driver\</DriverPackage>
    </PropertyGroup>
  </Target>
  <Target Name="BuildDriver" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' And '$(AppleRemoteDriver)' != 'false'">
    <Exec Command="powershell -NoProfile -Command &quot;$ErrorActionPreference='Stop'; New-Item -ItemType Directory -Force '$(DriverPackage)' | Out-Null; Invoke-WebRequest https://github.com/AnthoDingo/AppleRemoteWin-Driver/releases/latest/download/AppleRemoteDriver.zip -OutFile '$(DriverPackage)AppleRemoteDriver.zip'; Expand-Archive -Force '$(DriverPackage)AppleRemoteDriver.zip' '$(DriverPackage)'&quot;" ContinueOnError="WarnAndContinue" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="DriverExitCode" />
    </Exec>
    <ItemGroup Condition="'$(DriverExitCode)' == '0'">
      <DriverFile Include="$(DriverPackage)AppleRemoteDriver.sys;$(DriverPackage)AppleRemoteDriver.inf;$(DriverPackage)appleremotedriver.cat;$(DriverPackage)WDRLocalTestCert.cer" />
    </ItemGroup>
    <Copy SourceFiles="@(DriverFile)" DestinationFolder="$(OutDir)driver\" Condition="'$(DriverExitCode)' == '0'" />
  </Target>

  <!-- Dongle firmware (github.com/AnthoDingo/AppleRemoteWin-Dongle): the signed AppleRemoteEsp32.bin of its latest
       release, shipped as firmware\AppleRemoteEsp32.bin; the app is the dongle's only update channel. Release builds only;
       -p:EspFirmware=<signed .bin> ships a local build instead (any configuration). Offline or AppleRemoteDongle=false:
       not shipped, no update offered. -->
  <Target Name="DongleFirmwarePath" BeforeTargets="DongleFirmware;PublishDongleFirmware">
    <PropertyGroup>
      <DongleFirmware Condition="'$(EspFirmware)' != ''">$(EspFirmware)</DongleFirmware>
      <DongleFirmware Condition="'$(EspFirmware)' == ''">$(MSBuildProjectDirectory)\$(IntermediateOutputPath)dongle\AppleRemoteEsp32.bin</DongleFirmware>
    </PropertyGroup>
  </Target>
  <Target Name="DongleFirmware" AfterTargets="Build" Condition="('$(Configuration)' == 'Release' Or '$(EspFirmware)' != '') And '$(AppleRemoteDongle)' != 'false'">
    <Exec Condition="'$(EspFirmware)' == ''" Command="powershell -NoProfile -Command &quot;$ErrorActionPreference='Stop'; New-Item -ItemType Directory -Force (Split-Path '$(DongleFirmware)') | Out-Null; Invoke-WebRequest https://github.com/AnthoDingo/AppleRemoteWin-Dongle/releases/latest/download/AppleRemoteEsp32.bin -OutFile '$(DongleFirmware)'&quot;" ContinueOnError="WarnAndContinue" StandardOutputImportance="low" />
    <Copy SourceFiles="$(DongleFirmware)" DestinationFiles="$(OutDir)firmware\AppleRemoteEsp32.bin" Condition="Exists('$(DongleFirmware)')" />
  </Target>
  <Target Name="PublishDongleFirmware" AfterTargets="Publish" Condition="('$(Configuration)' == 'Release' Or '$(EspFirmware)' != '') And '$(AppleRemoteDongle)' != 'false'">
    <Copy SourceFiles="$(DongleFirmware)" DestinationFiles="$(PublishDir)firmware\AppleRemoteEsp32.bin" Condition="Exists('$(DongleFirmware)')" ContinueOnError="WarnAndContinue" />
  </Target>

  <!-- Publish: the driver package ALWAYS goes in <PublishDir>driver\ (never at the root, where files can be
       locked by the test VM reading the shared folder). The 4 files go together: the .cat signs this .sys. -->
  <Target Name="PublishDriver" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <PublishedDriverFile Include="$(DriverPackage)AppleRemoteDriver.sys;$(DriverPackage)AppleRemoteDriver.inf;$(DriverPackage)appleremotedriver.cat;$(DriverPackage)WDRLocalTestCert.cer" />
    </ItemGroup>
    <!-- A file held open (VMware, VM share) must not fail the publish: warning only. -->
    <Copy SourceFiles="@(PublishedDriverFile)" DestinationFolder="$(PublishDir)driver\" SkipUnchangedFiles="true" Retries="2" RetryDelayMilliseconds="500" ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
