<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>AppleRemote.App</RootNamespace>
    <AssemblyName>AppleRemote</AssemblyName>
    <Version>1.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Debug page and its menu entry: off by default, enabled only by a Debug build. -->
    <EnableDebugPage>false</EnableDebugPage>
    <EnableDebugPage Condition="'$(Configuration)' == 'Debug'">true</EnableDebugPage>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableDebugPage)' == 'true'">
    <DefineConstants>$(DefineConstants);DEBUG_PAGE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AppleRemote.DriverInstaller\AppleRemote.DriverInstaller.csproj" />
    <ProjectReference Include="..\AppleRemote.Windows\AppleRemote.Windows.csproj" />
    <!-- The filter installer (elevation) is copied next to the exe; the application references none of its types. -->
    <ProjectReference Include="..\AppleRemote.DriverInstaller\AppleRemote.DriverInstaller.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="WPF-UI.Tray" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Éditeur de macro : Blockly 11.2.2 (Apache-2.0) et sa page, servis au WebView2 depuis le dossier de l'exe. -->
    <Content Include="Blockly\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Realtek RTL8761B patch (TP-Link UB500) from linux-firmware rtl_bt/, sent by RealtekFirmware under WinUSB;
         redistributable unmodified with its licence. -->
    <Content Include="firmware\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\" />
  </ItemGroup>

  <!-- Release: builds and signs (test certificate) the AppleRemoteDriver kernel filter, then copies it next to the exe.
       Without the Rust/WDK toolchain, the step is skipped with a warning (AppleRemoteDriver=false to skip it). -->
  <PropertyGroup>
    <DriverDir>$(MSBuildThisFileDirectory)..\AppleRemoteDriver\</DriverDir>
    <DriverPackage>$(DriverDir)target\release\AppleRemoteDriver_package\</DriverPackage>
  </PropertyGroup>
  <Target Name="BuildDriver" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' And '$(AppleRemoteDriver)' != 'false'">
    <Exec Command="cargo make --profile release" WorkingDirectory="$(DriverDir)" EnvironmentVariables="LIBCLANG_PATH=$(ProgramFiles)\LLVM\bin" ContinueOnError="WarnAndContinue" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="DriverExitCode" />
    </Exec>
    <ItemGroup Condition="'$(DriverExitCode)' == '0'">
      <DriverFile Include="$(DriverPackage)AppleRemoteDriver.sys;$(DriverPackage)AppleRemoteDriver.inf;$(DriverPackage)appleremotedriver.cat;$(DriverPackage)WDRLocalTestCert.cer" />
    </ItemGroup>
    <Copy SourceFiles="@(DriverFile)" DestinationFolder="$(OutDir)driver\" Condition="'$(DriverExitCode)' == '0'" />
  </Target>

  <!-- Publish: the driver package ALWAYS goes in <PublishDir>driver\ (never at the root, where files can be
       locked by the test VM reading the shared folder). The 4 files go together: the .cat signs this .sys. -->
  <Target Name="PublishDriver" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release' And Exists('$(DriverPackage)AppleRemoteDriver.sys')">
    <ItemGroup>
      <PublishedDriverFile Include="$(DriverPackage)AppleRemoteDriver.sys;$(DriverPackage)AppleRemoteDriver.inf;$(DriverPackage)appleremotedriver.cat;$(DriverPackage)WDRLocalTestCert.cer" />
    </ItemGroup>
    <!-- A file held open (VMware, VM share) must not fail the publish: warning only, and the package remains
         to be checked (cmp against the target folder). -->
    <Copy SourceFiles="@(PublishedDriverFile)" DestinationFolder="$(PublishDir)driver\" SkipUnchangedFiles="true" Retries="2" RetryDelayMilliseconds="500" ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
