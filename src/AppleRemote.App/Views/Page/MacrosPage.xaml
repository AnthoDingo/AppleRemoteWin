<Page xmlns:l="clr-namespace:AppleRemote.App" x:Class="AppleRemote.App.Views.MacrosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:c="clr-namespace:AppleRemote.App.Controls"
      ScrollViewer.CanContentScroll="False">
    <!-- Macro list on the left, block editor of the selected macro on the right. -->
    <Page.Resources>
        <ResourceDictionary Source="/AppleRemote;component/Styles/Styles.xaml" />
    </Page.Resources>

    <Grid Margin="18,6,18,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,16,0" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{l:T Nav.Macros}" Style="{StaticResource Section}" />
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <ui:Button Icon="{ui:SymbolIcon Add24}" ToolTip="{l:T Macros.New}" Command="{Binding NewCommand}" Click="New_Click" Margin="0,0,6,0" />
                    <ui:Button Icon="{ui:SymbolIcon Copy24}" ToolTip="{l:T Pick.DuplicateMacro}" Command="{Binding DuplicateCommand}" Margin="0,0,6,0" />
                    <ui:Button Icon="{ui:SymbolIcon Delete24}" ToolTip="{l:T Macro.DeleteMacro}" Command="{Binding DeleteCommand}" Margin="0,0,6,0" Appearance="Danger" />
                    <ui:Button Icon="{ui:SymbolIcon Save24}" ToolTip="{l:T Macros.Save}" Command="{Binding SaveCommand}" Appearance="Success" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Macros}" SelectedItem="{Binding SelectedMacro}" />
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{l:T Macro.Name}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                <DockPanel>
                    <!-- While a test runs, the same button stops it. -->
                    <ui:Button DockPanel.Dock="Right" Command="{Binding TestCommand}" Appearance="Primary" Margin="8,0,0,0" VerticalAlignment="Stretch">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Icon" Value="{ui:SymbolIcon Play24}" />
                                <Setter Property="ToolTip" Value="{l:T Macros.Test}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Testing}" Value="True">
                                        <Setter Property="Icon" Value="{ui:SymbolIcon Stop24}" />
                                        <Setter Property="ToolTip" Value="{l:T Macros.StopTest}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                    <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
            </StackPanel>
            <c:MacroEditor x:Name="Editor" Grid.Row="1" />
        </Grid>
    </Grid>
</Page>
