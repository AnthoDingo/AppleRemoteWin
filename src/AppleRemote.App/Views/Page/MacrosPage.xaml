<Page xmlns:l="clr-namespace:AppleRemote.App" x:Class="AppleRemote.App.Views.MacrosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:c="clr-namespace:AppleRemote.App.Controls"
      ScrollViewer.CanContentScroll="False">
    <!-- Macro list on the left, block editor of the selected macro on the right. -->
    <Page.Resources>
        <ResourceDictionary Source="/AppleRemote;component/Styles/Styles.xaml" />
    </Page.Resources>

    <Grid Margin="18,6,18,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,16,0" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{l:T Nav.Macros}" Style="{StaticResource Section}" />
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <ui:Button Icon="{ui:SymbolIcon Add24}" ToolTip="{l:T Macros.New}" Click="New_Click" Margin="0,0,6,0" />
                    <ui:Button x:Name="DuplicateButton" Icon="{ui:SymbolIcon Copy24}" ToolTip="{l:T Pick.DuplicateMacro}" Click="Duplicate_Click" Margin="0,0,6,0" IsEnabled="False" />
                    <ui:Button x:Name="DeleteButton" Icon="{ui:SymbolIcon Delete24}" ToolTip="{l:T Macro.DeleteMacro}" Click="Delete_Click" Margin="0,0,6,0" IsEnabled="False" Appearance="Danger" />
                    <ui:Button x:Name="SaveButton" Icon="{ui:SymbolIcon Save24}" ToolTip="{l:T Macros.Save}" Click="Save_Click" IsEnabled="False" Appearance="Success" />
                </StackPanel>
                <ListBox x:Name="List" ItemsSource="{Binding MacroChoices}" SelectionChanged="List_SelectionChanged" />
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{l:T Macro.Name}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                <DockPanel>
                    <ui:Button x:Name="TestButton" DockPanel.Dock="Right" Icon="{ui:SymbolIcon Play24}" ToolTip="{l:T Macros.Test}"
                               Click="Test_Click" IsEnabled="False" Appearance="Primary" Margin="8,0,0,0" VerticalAlignment="Stretch" />
                    <TextBox x:Name="NameBox" TextChanged="Refresh" />
                </DockPanel>
            </StackPanel>
            <c:MacroEditor x:Name="Editor" Grid.Row="1" Changed="Refresh" />
        </Grid>
    </Grid>
</Page>
