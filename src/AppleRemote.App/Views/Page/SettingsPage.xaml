<Page xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:l="clr-namespace:AppleRemote.App" xmlns:c="clr-namespace:AppleRemote.App.Controls" x:Class="AppleRemote.App.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:AppleRemote.App.Views">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Branch" TargetType="Rectangle">
                <Setter Property="Fill" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="BranchStem" TargetType="Rectangle" BasedOn="{StaticResource Branch}">
                <Style.Triggers><DataTrigger Binding="{Binding AnyOn}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                </DataTrigger></Style.Triggers>
            </Style>
            <Style x:Key="BranchWinUsb" TargetType="Rectangle" BasedOn="{StaticResource Branch}">
                <Style.Triggers><DataTrigger Binding="{Binding WinUsbOn}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                </DataTrigger></Style.Triggers>
            </Style>
            <Style x:Key="BranchFilter" TargetType="Rectangle" BasedOn="{StaticResource Branch}">
                <Style.Triggers><DataTrigger Binding="{Binding FilterOn}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                </DataTrigger></Style.Triggers>
            </Style>
            <Style x:Key="Pointer" TargetType="Line">
                <Setter Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="StrokeThickness" Value="1.5" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Margin="18,6,18,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,32,0">
        <TextBlock Text="{l:T Settings.RemoteKeys}" Style="{StaticResource Section}" />
        <!-- Remote at 0.5 scale (190 × 600); comboboxes and lines are hand-aligned on its buttons. -->
        <Grid Width="690" Height="500" HorizontalAlignment="Center" Margin="0,0,0,14">
            <!-- Nothing under Play/Volume: the remote is cut off there -->
            <Grid Width="190" Height="440" Margin="250,50,250,0" VerticalAlignment="Top" ClipToBounds="True">
                <Viewbox Width="190" Height="600" VerticalAlignment="Top" Stretch="Uniform">
                    <local:RemoteDrawing DataContext="{Binding Remote}" IsEnabled="False" />
                </Viewbox>
            </Grid>
            <Canvas>
            <c:KeyPicker Canvas.Left="270" Canvas.Top="0" Width="150" Choices="{Binding KeyChoices}" Software="{Binding SoftwareChoices}" Macros="{Binding MacroChoices}" Key="{Binding Bindings[up].Key}" />
            <c:KeyPicker Canvas.Left="92" Canvas.Top="94" Width="150" Choices="{Binding KeyChoices}" Software="{Binding SoftwareChoices}" Macros="{Binding MacroChoices}" Key="{Binding Bindings[left].Key}" />
            <c:KeyPicker Canvas.Left="270" Canvas.Top="94" Width="150" Choices="{Binding KeyChoices}" Software="{Binding SoftwareChoices}" Macros="{Binding MacroChoices}" Key="{Binding Bindings[click].Key}" />
            <Line X1="242" Y1="268" X2="272" Y2="268" Style="{StaticResource Pointer}" />
            <c:KeyPicker Canvas.Left="92" Canvas.Top="252" Width="150" Choices="{Binding KeyChoices}" Software="{Binding SoftwareChoices}" Macros="{Binding MacroChoices}" Key="{Binding Bindings[menu].Key}" />
            <Line X1="242" Y1="348" X2="273" Y2="348" Style="{StaticResource Pointer}" />
            <c:KeyPicker Canvas.Left="92" Canvas.Top="332" Width="150" Choices="{Binding KeyChoices}" Software="{Binding SoftwareChoices}" Macros="{Binding MacroChoices}" Key="{Binding Bindings[siri].Key}" />
            <Line X1="242" Y1="428" X2="273" Y2="428" Style="{StaticResource Pointer}" />
            <c:KeyPicker Canvas.Left="92" Canvas.Top="412" Width="150" Choices="{Binding KeyChoices}" Software="{Binding SoftwareChoices}" Macros="{Binding MacroChoices}" Key="{Binding Bindings[playpause].Key}" />
            <c:KeyPicker Canvas.Left="270" Canvas.Top="174" Width="150" Choices="{Binding KeyChoices}" Software="{Binding SoftwareChoices}" Macros="{Binding MacroChoices}" Key="{Binding Bindings[down].Key}" />
            <c:KeyPicker Canvas.Left="448" Canvas.Top="94" Width="150" Choices="{Binding KeyChoices}" Software="{Binding SoftwareChoices}" Macros="{Binding MacroChoices}" Key="{Binding Bindings[right].Key}" />
            <Line X1="448" Y1="268" X2="415" Y2="268" Style="{StaticResource Pointer}" />
            <c:KeyPicker Canvas.Left="448" Canvas.Top="252" Width="150" Choices="{Binding KeyChoices}" Software="{Binding SoftwareChoices}" Macros="{Binding MacroChoices}" Key="{Binding Bindings[tv].Key}" />
            <Line X1="448" Y1="352" X2="418" Y2="352" Style="{StaticResource Pointer}" />
            <c:KeyPicker Canvas.Left="448" Canvas.Top="336" Width="150" Choices="{Binding KeyChoices}" Software="{Binding SoftwareChoices}" Macros="{Binding MacroChoices}" Key="{Binding Bindings[volup].Key}" />
            <Line X1="448" Y1="423" X2="418" Y2="423" Style="{StaticResource Pointer}" />
            <c:KeyPicker Canvas.Left="448" Canvas.Top="407" Width="150" Choices="{Binding KeyChoices}" Software="{Binding SoftwareChoices}" Macros="{Binding MacroChoices}" Key="{Binding Bindings[voldown].Key}" />
            </Canvas>
        </Grid>
        </StackPanel>
        <StackPanel Grid.Column="1">
        <TextBlock Text="{l:T Settings.Language}" Style="{StaticResource Section}" />
        <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Name" SelectedValuePath="Code"
                  SelectedValue="{Binding Language}" MinWidth="220" HorizontalAlignment="Left" Margin="0,0,0,14" />

        <TextBlock Text="{l:T Settings.General}" Style="{StaticResource Section}" />
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <ui:ToggleSwitch IsChecked="{Binding RunAtStartup}" Content="{l:T Settings.RunAtStartup}" Margin="0,0,0,8" />
                <ui:ToggleSwitch IsChecked="{Binding CloseToTray}" Content="{l:T Settings.CloseToTray}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                <ui:Button Icon="{ui:SymbolIcon FolderZip24}" Content="{l:T Settings.ExportAll}" Command="{Binding ExportAllCommand}" />
                <ui:Button Icon="{ui:SymbolIcon ArrowDownload24}" Content="{l:T Settings.ImportAll}" Command="{Binding ImportAllCommand}" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <TextBlock Text="{l:T Settings.Keyboard}" Style="{StaticResource Section}" />
        <ui:ToggleSwitch IsChecked="{Binding KeyboardEnabled}"
                  Content="{l:T Settings.KeyboardCheck}" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <ui:Button Icon="{ui:SymbolIcon ArrowReset24}" Content="{l:T Settings.DefaultMap}" Command="{Binding ResetMapCommand}" />
            <ui:Button Icon="{ui:SymbolIcon ArrowExportUp24}" Content="{l:T Settings.ExportMap}" Command="{Binding ExportMapCommand}" Margin="8,0,0,0" />
            <ui:Button Icon="{ui:SymbolIcon ArrowImport24}" Content="{l:T Settings.ImportMap}" Command="{Binding ImportMapCommand}" Margin="8,0,0,0" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,2">
            <TextBlock Text="{l:T Settings.Driver}" Style="{StaticResource Section}" Margin="0" VerticalAlignment="Center" />
            <Button Command="{Binding RefreshDriverCommand}" IsEnabled="{Binding DriverIdle}" ToolTip="{l:T Settings.Refresh}"
                    Cursor="Hand" Padding="6,2" Margin="6,0,0,0" Background="Transparent" BorderThickness="0">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" />
            </Button>
        </StackPanel>
        <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}" IsEnabled="{Binding DriverIdle}"
                  Visibility="{Binding SeveralAdapters, Converter={StaticResource BoolToVisibility}}"
                  MinWidth="220" HorizontalAlignment="Center" Margin="0,4,0,8" />
        <TextBlock Text="{Binding DriverText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="14" /><RowDefinition Height="14" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Width="2" Style="{StaticResource BranchStem}" />
            <Rectangle Grid.Row="1" Grid.Column="1" Height="2" VerticalAlignment="Top" Style="{StaticResource BranchWinUsb}" />
            <Rectangle Grid.Row="1" Grid.Column="2" Height="2" VerticalAlignment="Top" Style="{StaticResource BranchFilter}" />
            <Rectangle Grid.Row="1" Grid.Column="0" Width="2" HorizontalAlignment="Right" Style="{StaticResource BranchWinUsb}" />
            <Rectangle Grid.Row="1" Grid.Column="3" Width="2" HorizontalAlignment="Left" Style="{StaticResource BranchFilter}" />
            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,8,0">
                <TextBlock Text="{l:T Settings.Option1}" FontWeight="SemiBold" TextAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,14" />
                <WrapPanel IsEnabled="{Binding DriverIdle}" HorizontalAlignment="Center">
                    <Button Content="{Binding WinUsbButton}" IsEnabled="{Binding CanToggleWinUsb}" Command="{Binding ToggleWinUsbCommand}" />
                </WrapPanel>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Margin="8,0,0,0">
                <TextBlock Text="{l:T Settings.Option2}" FontWeight="SemiBold" TextAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,14" />
                <WrapPanel IsEnabled="{Binding DriverIdle}" HorizontalAlignment="Center">
                    <Button Content="{Binding FilterButton}" IsEnabled="{Binding CanToggleFilter}" Command="{Binding ToggleFilterCommand}" />
                </WrapPanel>
            </StackPanel>
        </Grid>
        </StackPanel>
    </Grid>

    <!-- Footer banner: build, repository, license -->
    <Border Grid.Row="1" Padding="18,8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}">
            <TextBlock VerticalAlignment="Center"><Run Text="{l:T Settings.Version}" /> <Run Text="{Binding AppVersion, Mode=OneWay}" /></TextBlock>
            <TextBlock Text="·" Margin="12,0" VerticalAlignment="Center" />
            <ui:HyperlinkButton Content="github.com/AnthoDingo/AppleRemoteWin" NavigateUri="https://github.com/AnthoDingo/AppleRemoteWin" Padding="0" />
            <TextBlock Text="·" Margin="12,0" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center"><Run Text="{l:T Settings.License}" /> AGPL-3.0-or-later</TextBlock>
            <TextBlock Text="·" Margin="12,0" VerticalAlignment="Center" />
            <ui:HyperlinkButton Content="{l:T Settings.Components}" Command="{Binding ShowComponentsCommand}" Padding="0" />
        </StackPanel>
    </Border>
    </Grid>
</Page>
