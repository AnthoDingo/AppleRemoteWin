<Page xmlns:l="clr-namespace:AppleRemote.App" x:Class="AppleRemote.App.Views.TutoPage" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:AppleRemote.App.Views">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Carousel: a TabControl whose tabs are dots under the slide. -->
            <Style x:Key="Carousel" TargetType="TabControl">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <DockPanel>
                                <TabPanel DockPanel.Dock="Bottom" IsItemsHost="True" HorizontalAlignment="Center" Margin="0,12,0,0" />
                                <Border Style="{StaticResource Card}" Margin="0">
                                    <ContentPresenter ContentSource="SelectedContent" />
                                </Border>
                            </DockPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="TabItem">
                            <!-- The content inherits from the TabItem (logical parent), whose default Windows style forces black. -->
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border Background="Transparent" Padding="6" ToolTip="{TemplateBinding Header}">
                                            <Ellipse x:Name="Dot" Width="10" Height="10"
                                                     Fill="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Dot" Property="Opacity" Value="0.7" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                <Setter TargetName="Dot" Property="Opacity" Value="1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <TabControl Style="{StaticResource Carousel}" Margin="18" MaxWidth="820" VerticalAlignment="Center">
        <TabItem Header="{l:T Guide.PairTitle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="190" Height="440" VerticalAlignment="Top" ClipToBounds="True" Margin="0,0,20,0">
                <Viewbox Width="190" Height="600" VerticalAlignment="Top" Stretch="Uniform">
                    <Grid Width="380" Height="1200">
                        <local:RemoteDrawing IsEnabled="False" />
                        <Canvas>
                                    <Ellipse Canvas.Left="32" Canvas.Top="360" Width="160" Height="160" Stroke="#4C8DFF" StrokeThickness="8"
                                             Fill="#334C8DFF" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                        <Ellipse.RenderTransform><ScaleTransform x:Name="S10" /></Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetName="S10" Storyboard.TargetProperty="ScaleX" From="0.75" To="1.15" Duration="0:0:0.7" />
                                                        <DoubleAnimation Storyboard.TargetName="S10" Storyboard.TargetProperty="ScaleY" From="0.75" To="1.15" Duration="0:0:0.7" />
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.7" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <Ellipse Canvas.Left="200" Canvas.Top="528" Width="160" Height="160" Stroke="#4C8DFF" StrokeThickness="8"
                                             Fill="#334C8DFF" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                        <Ellipse.RenderTransform><ScaleTransform x:Name="S11" /></Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetName="S11" Storyboard.TargetProperty="ScaleX" From="0.75" To="1.15" Duration="0:0:0.7" />
                                                        <DoubleAnimation Storyboard.TargetName="S11" Storyboard.TargetProperty="ScaleY" From="0.75" To="1.15" Duration="0:0:0.7" />
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.7" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                        </Canvas>
                    </Grid>
                </Viewbox>
            </Grid>
            <StackPanel Grid.Column="1">
                <TextBlock Text="{l:T Guide.PairTitle}" Style="{StaticResource Section}" />
            <DockPanel Margin="0,0,0,10"><TextBlock Text="•" Width="16" DockPanel.Dock="Left" /><TextBlock Text="{l:T Guide.Pair1}" TextWrapping="Wrap" /></DockPanel>
            <DockPanel Margin="0,0,0,10"><TextBlock Text="•" Width="16" DockPanel.Dock="Left" /><TextBlock Text="{l:T Guide.Pair2}" TextWrapping="Wrap" /></DockPanel>
            <DockPanel Margin="0,0,0,10"><TextBlock Text="•" Width="16" DockPanel.Dock="Left" /><TextBlock Text="{l:T Guide.Pair3}" TextWrapping="Wrap" /></DockPanel>
            <DockPanel Margin="0,0,0,10"><TextBlock Text="•" Width="16" DockPanel.Dock="Left" /><TextBlock Text="{l:T Guide.Pair4}" TextWrapping="Wrap" /></DockPanel>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Width="190" HorizontalAlignment="Left">
                <ProgressBar Minimum="0" Maximum="1" Height="6" Margin="0,6,0,4">
                    <ProgressBar.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="Value" From="0" To="1" Duration="0:0:5" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ProgressBar.Triggers>
                </ProgressBar>
                <TextBlock Text="{l:T Guide.Hold}" Style="{StaticResource Section}" />
            </StackPanel>
        </Grid>
        </TabItem>
        <TabItem Header="{l:T Guide.ResetTitle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="190" Height="440" VerticalAlignment="Top" ClipToBounds="True" Margin="0,0,20,0">
                <Viewbox Width="190" Height="600" VerticalAlignment="Top" Stretch="Uniform">
                    <Grid Width="380" Height="1200">
                        <local:RemoteDrawing IsEnabled="False" />
                        <Canvas>
                                    <Ellipse Canvas.Left="189" Canvas.Top="360" Width="160" Height="160" Stroke="#4C8DFF" StrokeThickness="8"
                                             Fill="#334C8DFF" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                        <Ellipse.RenderTransform><ScaleTransform x:Name="S00" /></Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetName="S00" Storyboard.TargetProperty="ScaleX" From="0.75" To="1.15" Duration="0:0:0.7" />
                                                        <DoubleAnimation Storyboard.TargetName="S00" Storyboard.TargetProperty="ScaleY" From="0.75" To="1.15" Duration="0:0:0.7" />
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.7" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <Ellipse Canvas.Left="200" Canvas.Top="673" Width="160" Height="160" Stroke="#4C8DFF" StrokeThickness="8"
                                             Fill="#334C8DFF" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                        <Ellipse.RenderTransform><ScaleTransform x:Name="S01" /></Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetName="S01" Storyboard.TargetProperty="ScaleX" From="0.75" To="1.15" Duration="0:0:0.7" />
                                                        <DoubleAnimation Storyboard.TargetName="S01" Storyboard.TargetProperty="ScaleY" From="0.75" To="1.15" Duration="0:0:0.7" />
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.7" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                        </Canvas>
                    </Grid>
                </Viewbox>
            </Grid>
            <StackPanel Grid.Column="1">
                <TextBlock Text="{l:T Guide.ResetTitle}" Style="{StaticResource Section}" />
            <DockPanel Margin="0,0,0,10"><TextBlock Text="•" Width="16" DockPanel.Dock="Left" /><TextBlock Text="{l:T Guide.Reset1}" TextWrapping="Wrap" /></DockPanel>
            <DockPanel Margin="0,0,0,10"><TextBlock Text="•" Width="16" DockPanel.Dock="Left" /><TextBlock Text="{l:T Guide.Reset2}" TextWrapping="Wrap" /></DockPanel>
            <DockPanel Margin="0,0,0,10"><TextBlock Text="•" Width="16" DockPanel.Dock="Left" /><TextBlock Text="{l:T Guide.Reset3}" TextWrapping="Wrap" /></DockPanel>
            <DockPanel Margin="0,0,0,10"><TextBlock Text="•" Width="16" DockPanel.Dock="Left" /><TextBlock Text="{l:T Guide.Reset4}" TextWrapping="Wrap" /></DockPanel>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Width="190" HorizontalAlignment="Left">
                <ProgressBar Minimum="0" Maximum="1" Height="6" Margin="0,6,0,4">
                    <ProgressBar.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="Value" From="0" To="1" Duration="0:0:5" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ProgressBar.Triggers>
                </ProgressBar>
                <TextBlock Text="{l:T Guide.Hold}" Style="{StaticResource Section}" />
            </StackPanel>
        </Grid>
        </TabItem>
        </TabControl>
    </ScrollViewer>
</Page>
