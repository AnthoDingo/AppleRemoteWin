<Page xmlns:l="clr-namespace:AppleRemote.App" x:Class="AppleRemote.App.Views.RemotePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:AppleRemote.App.Views"
      xmlns:controls="clr-namespace:AppleRemote.App.Controls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False">
    <!-- CanContentScroll=False: no scrolling around the page, the remote fits the window height. -->
    <Page.Resources>
        <ResourceDictionary Source="/Styles/Styles.xaml" />
    </Page.Resources>

    <Grid Margin="18,6,18,18" HorizontalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Left column: the remote, drawn to scale (380 × 1200), fitted to the window height -->
        <Viewbox Grid.Column="0" Margin="0,0,24,0" Stretch="Uniform" VerticalAlignment="Top">
            <local:RemoteDrawing />
        </Viewbox>

        <!-- Right column: status, start/stop, gesture -->
        <StackPanel Grid.Column="1" Width="520" VerticalAlignment="Center">
            <!-- Status card: indicator, message, battery, start/stop -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="{l:T Remote.State}" Style="{StaticResource Section}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="14" Height="14" Margin="0,7,12,0" VerticalAlignment="Top">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#6B7280" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusLevel}" Value="Ok">
                                                <Setter Property="Fill" Value="#3FB950" />
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#3FB950" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusLevel}" Value="Warn">
                                                <Setter Property="Fill" Value="#D29922" />
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#D29922" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding StatusTitle}" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,4,0,0"
                                           TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding StatusText}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="{Binding StartStopText}" Command="{Binding StartStopCommand}"
                               Appearance="Primary" MinWidth="110" Padding="16,9" Margin="0" VerticalAlignment="Top" />
                </Grid>
            </Border>

            <!-- Gesture card: touchpad and last gesture -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:T Remote.Gesture}" Style="{StaticResource Section}" />
                    <Border Height="190" CornerRadius="10" ClipToBounds="True" Margin="0,4,0,12"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <!-- Crosshair marks -->
                            <Rectangle Height="1" VerticalAlignment="Center" Opacity="0.25"
                                       Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Rectangle Width="1" HorizontalAlignment="Center" Opacity="0.25"
                                       Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Border Width="120" Height="84" CornerRadius="14" RenderTransformOrigin="0.5,0.5"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" />
                                </Border.Effect>
                                <Border.RenderTransform>
                                    <TranslateTransform X="{Binding TileShiftX}" Y="{Binding TileShiftY}" />
                                </Border.RenderTransform>
                                <TextBlock Text="{Binding MoveArrow}" FontSize="38"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding GestureText}" TextWrapping="Wrap" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Devices card: nearby "Apple HID" BLE advertisements, fixed height -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{l:T Remote.Nearby}" Style="{StaticResource Section}" VerticalAlignment="Center" />
                        <!-- Adapter choice (same as Settings), only with several adapters -->
                        <ComboBox DataContext="{Binding Preferences}" ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}"
                                  IsEnabled="{Binding CanChangeAdapter}" Visibility="{Binding SeveralAdapters, Converter={StaticResource BoolToVisibility}}"
                                  HorizontalAlignment="Right" MaxWidth="280" Margin="0,0,0,6" />
                    </Grid>
                    <Grid Height="140" Margin="0,4,0,0">
                        <!-- Same list as the BLE scanner: selectable rows, double-click = pair -->
                        <ui:ListView ItemsSource="{Binding NearbyDevices}" SelectedItem="{Binding SelectedNearby}"
                                     BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ui:ListView.ItemContainerStyle>
                                <Style TargetType="ui:ListViewItem" BasedOn="{StaticResource ListViewItemStyle}">
                                    <EventSetter Event="MouseDoubleClick" Handler="Row_DoubleClick" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Connected}" Value="True">
                                            <Setter Property="Foreground" Value="#3FB950" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:ListView.ItemContainerStyle>
                            <ui:ListView.View>
                                <ui:GridView>
                                    <ui:GridViewColumn Header="{l:T Ble.ColName}" Width="200" DisplayMemberBinding="{Binding Name}" />
                                    <ui:GridViewColumn Header="{l:T Ble.ColAddress}" Width="160" DisplayMemberBinding="{Binding Address}" />
                                    <ui:GridViewColumn Header="{l:T Ble.ColSignal}" Width="110" DisplayMemberBinding="{Binding Signal}" />
                                </ui:GridView>
                            </ui:ListView.View>
                        </ui:ListView>
                        <TextBlock Text="{l:T Remote.NearbyNone}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NearbyDevices.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <!-- Pairing in progress (double-click on a row): spinner, then the step / result text -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PairText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <controls:Beachball Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                            Visibility="{Binding IsPairing, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding PairText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxWidth="460" ToolTip="{Binding PairText}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
