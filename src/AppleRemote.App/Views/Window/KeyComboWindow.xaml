<ui:FluentWindow xmlns:l="clr-namespace:AppleRemote.App" Icon="pack://application:,,,/app.ico" x:Class="AppleRemote.App.Views.KeyComboWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{l:T Combo.Title}"
        Width="420" Height="260" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
        FontSize="13" WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="{l:T Combo.Title}" ShowMinimize="False" ShowMaximize="False" />
        <Grid Grid.Row="1" Margin="16,4,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{l:T Combo.Prompt}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Border Grid.Row="1" Margin="0,12" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <TextBlock x:Name="ComboText" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{l:T Combo.Reset}" Click="Reset_Click" Padding="12,6" Margin="0,0,8,0" />
                <ui:Button x:Name="ValidateButton" Content="{l:T Combo.Validate}" Click="Validate_Click" IsEnabled="False"
                        Appearance="Primary" Padding="12,6" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
