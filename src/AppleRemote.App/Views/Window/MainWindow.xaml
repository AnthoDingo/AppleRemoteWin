<ui:FluentWindow xmlns:l="clr-namespace:AppleRemote.App" Icon="pack://application:,,,/app.ico" x:Class="AppleRemote.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:AppleRemote.App.Views"
        xmlns:tray="clr-namespace:Wpf.Ui.Tray.Controls;assembly=Wpf.Ui.Tray"
        Title="{l:T App.Title}"
        WindowStartupLocation="CenterScreen" Width="1400" Height="800" MinWidth="860" MinHeight="640"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
        FontSize="13"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ui:TitleBar Title="{l:T App.Title}">
        <ui:TitleBar.Icon>
            <ui:ImageIcon Source="pack://application:,,,/app.ico" />
        </ui:TitleBar.Icon>
    </ui:TitleBar>
    <tray:NotifyIcon Icon="pack://application:,,,/app.ico" TooltipText="Siri Remote (gen 1)"
                   FocusOnLeftClick="True" MenuOnRightClick="True" LeftClick="Tray_Show">
        <tray:NotifyIcon.Menu>
            <ContextMenu x:Name="TrayMenu">
                <MenuItem Header="{Binding BatteryText}" IsEnabled="False" />
                <Separator />
                <MenuItem Header="{l:T Tray.Show}" Click="Tray_Show" />
                <MenuItem Header="{l:T Tray.Quit}" Click="Tray_Quit" />
            </ContextMenu>
        </tray:NotifyIcon.Menu>
    </tray:NotifyIcon>

    <!-- Menu on the left: the remote at the top; Settings and Debug at the bottom. -->
    <ui:NavigationView x:Name="RootNavigation" Grid.Row="1" PaneDisplayMode="Left" OpenPaneLength="200" IsPaneOpen="False"
                       IsBackButtonVisible="Collapsed" IsPaneToggleVisible="True">
        <ui:NavigationView.MenuItems>
            <ui:NavigationViewItem Content="{l:T Nav.Remote}" TargetPageType="{x:Type views:RemotePage}">
                <ui:NavigationViewItem.Icon>
                    <ui:SymbolIcon Symbol="Remote20" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem Content="{l:T Nav.Guide}" TargetPageType="{x:Type views:TutoPage}">
                <ui:NavigationViewItem.Icon>
                    <ui:SymbolIcon Symbol="Book24" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem Content="{l:T Nav.Macros}" TargetPageType="{x:Type views:MacrosPage}">
                <ui:NavigationViewItem.Icon>
                    <ui:SymbolIcon Symbol="PuzzlePiece24" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
        </ui:NavigationView.MenuItems>
        <ui:NavigationView.FooterMenuItems>
            <ui:NavigationViewItem Content="{l:T Nav.Settings}" TargetPageType="{x:Type views:SettingsPage}">
                <ui:NavigationViewItem.Icon>
                    <ui:SymbolIcon Symbol="Settings24" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem x:Name="DebugItem" Content="{l:T Nav.Debug}" TargetPageType="{x:Type views:DebugPage}">
                <ui:NavigationViewItem.Icon>
                    <ui:SymbolIcon Symbol="Bug24" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
        </ui:NavigationView.FooterMenuItems>
    </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
