<ui:FluentWindow xmlns:l="clr-namespace:AppleRemote.App" Icon="pack://application:,,,/app.ico" x:Class="AppleRemote.App.Views.BleScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{l:T Ble.Title}"
        Width="900" Height="600" MinWidth="720" MinHeight="440"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
        FontSize="13"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded" Closed="Window_Closed">

    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ui:TitleBar Title="{l:T Ble.Title}" ShowMinimize="False" />

    <Grid Grid.Row="1" Margin="16,4,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{l:T Ble.Intro}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" MinWidth="80" />
            <Button Content="{l:T Ble.Pair}" Command="{Binding PairCommand}" />
            <Button Content="{l:T Debug.Clear}" Command="{Binding ClearCommand}" />
            <Button Content="{l:T Ble.Copy}" Command="{Binding CopyCommand}" />
            <CheckBox IsChecked="{Binding OnlyLikely}" Content="{l:T Ble.OnlyLikely}"
                      VerticalAlignment="Center" Margin="8,0,0,0" />
            <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>

        <ui:ListView Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
            <ui:ListView.ItemContainerStyle>
                <Style TargetType="ui:ListViewItem" BasedOn="{StaticResource ListViewItemStyle}">
                    <EventSetter Event="MouseDoubleClick" Handler="Row_DoubleClick" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Likely}" Value="True">
                            <Setter Property="Foreground" Value="#3FB950" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding AppleNoHid}" Value="True">
                            <Setter Property="Foreground" Value="#F85149" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ui:ListView.ItemContainerStyle>
            <ui:ListView.View>
                <ui:GridView>
                    <ui:GridViewColumn Header="{l:T Ble.ColName}" Width="190" DisplayMemberBinding="{Binding NameText}" />
                    <ui:GridViewColumn Header="{l:T Ble.ColAddress}" Width="150" DisplayMemberBinding="{Binding Address}" />
                    <ui:GridViewColumn Header="{l:T Ble.ColSignal}" Width="70" DisplayMemberBinding="{Binding Rssi}" />
                    <ui:GridViewColumn Header="{l:T Ble.ColMaker}" Width="140" DisplayMemberBinding="{Binding Companies}" />
                    <ui:GridViewColumn Header="{l:T Ble.ColHints}" Width="250" DisplayMemberBinding="{Binding Note}" />
                </ui:GridView>
            </ui:ListView.View>
        </ui:ListView>

        <TextBlock Text="{Binding PairText}" Grid.Row="3" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </Grid>
    </Grid>
</ui:FluentWindow>
