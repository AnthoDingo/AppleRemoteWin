<ui:FluentWindow xmlns:l="clr-namespace:AppleRemote.App" Icon="pack://application:,,,/app.ico" x:Class="AppleRemote.App.Views.InputDropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="440" Height="260" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
        FontSize="13" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="Bar" ShowMinimize="False" ShowMaximize="False" />
        <Grid Grid.Row="1" Margin="16,4,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="PromptText" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Border Grid.Row="1" Margin="0,12" AllowDrop="True" Drop="Zone_Drop" DragOver="Zone_DragOver" CornerRadius="6"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <TextBlock x:Name="DropText" Text="{l:T Input.Drop}" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{l:T Macro.Cancel}" Click="Cancel_Click" Padding="12,6" Margin="0,0,8,0" />
                <ui:Button x:Name="ValidateButton" Content="{l:T Combo.Validate}" Click="Validate_Click" IsEnabled="False"
                           Appearance="Primary" Padding="12,6" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
