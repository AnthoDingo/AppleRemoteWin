<UserControl x:Class="AppleRemote.App.Views.RemoteDrawing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- La télécommande dessinée à l'échelle (380 × 1200), partagée par les pages Télécommande, Tuto et Settings.
         IsEnabled="False" : simple illustration, sans retour des touches ni des doigts. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="KeyOnBrush" Color="#4C8DFF" />
            <SolidColorBrush x:Key="ClickOnBrush" Color="#404C8DFF" />
            <!-- Les touches s'allument quand leur Tag (lié à l'état du view-model) vaut True, si le contrôle est actif. -->
            <Style x:Key="RemoteKey" TargetType="Border">
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{StaticResource True}" />
                            <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="{StaticResource True}" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource KeyOnBrush}" />
                    </MultiDataTrigger>
                </Style.Triggers>
                <Setter Property="Background">
                    <Setter.Value>
                        <RadialGradientBrush GradientOrigin="0.35,0.3">
                            <GradientStop Color="#36383C" Offset="0" />
                            <GradientStop Color="#17181A" Offset="1" />
                        </RadialGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="HalfKey" TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{StaticResource True}" />
                            <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="{StaticResource True}" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource KeyOnBrush}" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="TouchKey" TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{StaticResource True}" />
                            <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="{StaticResource True}" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource ClickOnBrush}" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="RemoteGlyph" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="40" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Width="380" Height="1200" CornerRadius="48" Background="#161719"
            BorderBrush="#4A4D52" BorderThickness="3">
        <Grid>
            <!-- Partie basse en verre brillant -->
            <Border VerticalAlignment="Bottom" Height="680" CornerRadius="0,0,45,45">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2E3034" Offset="0" />
                        <GradientStop Color="#0B0B0C" Offset="0.45" />
                        <GradientStop Color="#000000" Offset="0.7" />
                        <GradientStop Color="#151618" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Canvas>
                <!-- Niveau de batterie, en bas de la télécommande -->
                <Grid Canvas.Left="0" Canvas.Top="1100" Width="380">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="&#xEBA7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="34"
                               Foreground="#9AA0A6" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding BatteryPercent}" FontSize="30" Foreground="#9AA0A6"
                               VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <Rectangle Canvas.Left="180" Canvas.Top="22" Width="14" Height="5" RadiusX="2.5" RadiusY="2.5"
                           Fill="#050506" />

                <!-- Surface tactile (s'allume au clic) -->
                <Border Style="{StaticResource TouchKey}" Tag="{Binding TouchPressed}"
                        Canvas.Left="7" Canvas.Top="10" Width="360" Height="360"
                        CornerRadius="36" ToolTip="Surface tactile (clic)">
                    <Grid Width="360" Height="360" ClipToBounds="True"
                          Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVisibility}}">
                        <Canvas>
                            <Polyline Points="{Binding TrailPoints}" Stroke="#4C8DFF" StrokeThickness="3"
                                      StrokeLineJoin="Round" Opacity="0.55" />
                        </Canvas>
                        <ItemsControl ItemsSource="{Binding Fingers}" IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                    <Setter Property="Visibility"
                                            Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Ellipse Width="30" Height="30" Opacity="0.9">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#F2F4F8" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Index}" Value="1">
                                                        <Setter Property="Fill" Value="#FFB454" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Tag="{Binding MenuPressed}" Style="{StaticResource RemoteKey}" Canvas.Left="45" Canvas.Top="373"
                        Width="128" Height="128" CornerRadius="64" BorderBrush="#E6E6E6" BorderThickness="4"
                        ToolTip="Menu">
                    <TextBlock Text="MENU" FontSize="26" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Tag="{Binding TvPressed}" Style="{StaticResource RemoteKey}" Canvas.Left="202" Canvas.Top="373"
                        Width="128" Height="128" CornerRadius="64" ToolTip="TV">
                    <TextBlock Text="&#xE7F4;" Style="{StaticResource RemoteGlyph}" />
                </Border>
                <Border Tag="{Binding SiriPressed}" Style="{StaticResource RemoteKey}" Canvas.Left="47" Canvas.Top="535"
                        Width="124" Height="124" CornerRadius="62" ToolTip="Siri">
                    <TextBlock Text="&#xE720;" Style="{StaticResource RemoteGlyph}" />
                </Border>
                <Border Tag="{Binding PlayPressed}" Style="{StaticResource RemoteKey}" Canvas.Left="47" Canvas.Top="694"
                        Width="124" Height="124" CornerRadius="62" ToolTip="Lecture / pause">
                    <Path Data="M0,0 L15,9 L0,18 Z M21,0 H25 V18 H21 Z M29,0 H33 V18 H29 Z" Fill="White"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Volume : une pilule, deux moitiés -->
                <Grid Canvas.Left="217" Canvas.Top="535" Width="120" Height="283">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Border Grid.RowSpan="2" Style="{StaticResource RemoteKey}" CornerRadius="60" />
                    <Border Tag="{Binding VolUpPressed}" Style="{StaticResource HalfKey}" CornerRadius="60,60,0,0"
                            ToolTip="Volume +">
                        <TextBlock Text="+" FontSize="48" FontWeight="Light" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Tag="{Binding VolDownPressed}" Style="{StaticResource HalfKey}" Grid.Row="1"
                            CornerRadius="0,0,60,60" ToolTip="Volume −">
                        <TextBlock Text="−" FontSize="48" FontWeight="Light" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Canvas>
        </Grid>
    </Border>
</UserControl>
